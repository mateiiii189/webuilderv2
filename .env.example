# Public business address for project enquiries.
CONTACT_EMAIL=admin@webuilder.ro
# Public WhatsApp number in international format, e.g. +40 followed by the number without its initial 0.
# Leave blank to hide the WhatsApp contact button.
CONTACT_WHATSAPP=

# Server-only. Use the deployed Web App /exec URL, not the editor or /dev URL.
GOOGLE_APPS_SCRIPT_URL=
# Must match BOOKING_API_SECRET in Apps Script → Project Settings → Script properties.
BOOKING_API_SECRET=
