# Public business address for project enquiries.
CONTACT_EMAIL=admin@webuilder.ro
# Public WhatsApp number in international format, e.g. +40 followed by the number without its initial 0.
# Leave blank to hide the Telefon and WhatsApp text entries.
CONTACT_WHATSAPP=

# Server-only. Use the deployed Web App /exec URL, not the editor or /dev URL.
GOOGLE_APPS_SCRIPT_URL=
# Must match BOOKING_API_SECRET in Apps Script → Project Settings → Script properties.
BOOKING_API_SECRET=

# Sanity project (public identifiers, not secrets). Create a public production dataset.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional, server-only Viewer token for a private dataset. Leave blank for a public dataset.
SANITY_API_READ_TOKEN=

# Local seed script only. Editor token; never use a NEXT_PUBLIC prefix.
SANITY_API_WRITE_TOKEN=
