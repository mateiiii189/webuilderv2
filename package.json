{
  "name": "webuilder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:booking": "BOOKING_INTEGRATION_TEST=1 playwright test",
    "test:sanity": "SANITY_INTEGRATION_TEST=1 playwright test tests/sanity.spec.ts",
    "seed:projects": "node --env-file-if-exists=.env.local scripts/seed-projects.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@sanity/client": "^8.6.2",
    "@sanity/image-url": "^2.1.1",
    "next": "16.3.4",
    "next-sanity": "^13.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6.15.0",
    "styled-components": "^6.5.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "groq-js": "^2.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
